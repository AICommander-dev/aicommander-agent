<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.aicommander.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/aicommander-agent</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AICOMMANDER_SERVER</key>
    <string>https://aicommander.dev</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/var/log/aicommander-agent.log</string>

  <key>StandardErrorPath</key>
  <string>/var/log/aicommander-agent-error.log</string>
</dict>
</plist>
